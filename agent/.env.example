# Copy to .env for local runs (`docker run --env-file agent/.env ...` or
# `export $(grep -v '^#' agent/.env | xargs)` before `uvicorn app.main:app`).
# Never commit the real file — .gitignore already refuses it.

# Required. Rotate immediately if this value is ever pasted anywhere other
# than this file or Coolify's environment settings — including into a chat
# with an AI assistant, a Slack message, or a GitHub issue.
OPENAI_API_KEY=sk-...

# Required. Shared secret the app API sends as X-Internal-Key on every call
# (see api/internal/upstream/agent.go). Generate with e.g. `openssl rand -hex 32`
# and set the identical value on both this service and the app API's
# AGENT_SECRET_KEY. Anyone with this value can spend your OpenAI budget, so
# treat it like the API key itself.
AGENT_SECRET_KEY=

# Optional — defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# Optional — defaults to 8092.
PORT=8092
